<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页品牌区：深色斜向渐变 + 右上 / 左下两团品牌橙光晕（日夜间一致） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#101015"
                android:startColor="#25232D"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="560dp"
        android:gravity="top|end"
        android:right="-220dp"
        android:top="-240dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#22F97910"
                android:endColor="#00F97910"
                android:gradientRadius="280dp"
                android:startColor="#66F97910"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="-200dp"
        android:gravity="bottom|start"
        android:left="-160dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FF9A3C"
                android:gradientRadius="210dp"
                android:startColor="#33FF9A3C"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
