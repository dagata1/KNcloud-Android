<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_node"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_spacing_dp16"
    android:layout_marginEnd="@dimen/margin_spacing_dp16"
    android:layout_marginTop="@dimen/margin_spacing_dp4"
    android:layout_marginBottom="@dimen/margin_spacing_dp4"
    app:cardBackgroundColor="@color/card_node_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_node_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/padding_spacing_dp12">

        <!-- Top Row: Node Name & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_active_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/margin_spacing_dp8"
                android:src="@drawable/ic_fab_check"
                android:visibility="gone"
                app:tint="@color/color_fab_active" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/md_theme_onSurface"
                android:textStyle="bold"
                tools:text="香港 [01] 专线 4K" />

            <LinearLayout
                android:id="@+id/layout_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layout_share"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/title_configuration_share"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_share_24dp"
                        app:tint="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_edit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/menu_item_edit_config"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_edit_24dp"
                        app:tint="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_remove"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/menu_item_del_config"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_delete_24dp"
                        app:tint="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_more"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/notification_action_more"
                    android:focusable="true"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_more_vert_24dp"
                        app:tint="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Middle Row: Server address info & sub icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_spacing_dp4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_subscription"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/margin_spacing_dp4"
                android:background="@drawable/ic_circle"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_subscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textSize="9sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_statistics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="@color/md_theme_onSurfaceVariant"
                tools:text="hk.kncloud.*** : 456" />
        </LinearLayout>

        <!-- Bottom Row: Protocol Badge & Latency Test Result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_spacing_dp8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="@dimen/padding_spacing_dp8"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/padding_spacing_dp8"
                android:paddingBottom="2dp"
                android:textColor="@color/color_fab_active"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="SHADOWSOCKS" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="@dimen/padding_spacing_dp8"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/padding_spacing_dp8"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPing"
                android:textSize="10sp"
                tools:text="83 ms" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
